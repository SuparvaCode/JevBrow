{
  "name": "jevbrow",
  "version": "1.1.1",
  "description": "Natural language browser driver and automation framework using Jev AI (TypeSafe System One) with OpenAI-compatible LLM fallback. Fast, accurate, lightweight.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "browser-automation",
    "ai",
    "jev",
    "typesafe",
    "captcha",
    "playwright",
    "headless",
    "web-scraping",
    "system-one"
  ],
  "author": "Suparva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuparvaCode/JevBrow.git"
  },
  "bugs": {
    "url": "https://github.com/SuparvaCode/JevBrow/issues"
  },
  "homepage": "https://github.com/SuparvaCode/JevBrow#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "openai": "^4.73.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
